DATABASE_URL=postgresql://campusride:campusride@localhost:5433/campusride

# Any OpenAI-compatible endpoint works (OpenAI, Groq, Gemini's OpenAI endpoint, OpenRouter, Ollama).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Gemini
# LLM_BASE_URL=https://api.groq.com/openai/v1                              # Groq
# LLM_BASE_URL=http://localhost:11434/v1                                   # Ollama

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5

# Observability (docker compose --profile obs up -d)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_JSON=true
