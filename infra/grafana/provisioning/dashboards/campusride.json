{
 "uid": "campusride",
 "title": "CampusRide",
 "schemaVersion": 39,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Matching latency (p50 / p95 / p99)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(match_duration_seconds_bucket{outcome=\"matched\"}[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(match_duration_seconds_bucket{outcome=\"matched\"}[1m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(match_duration_seconds_bucket{outcome=\"matched\"}[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Match outcomes / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(match_attempts_total[1m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "HTTP p95 by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[1m])))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Request rate by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(http_request_duration_seconds_count[1m]))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Open WebSockets",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (ws_connections)",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Ride transitions / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (to_status) (rate(ride_transitions_total[1m]))",
     "legendFormat": "{{to_status}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Agent turn latency (p50 / p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(agent_turn_duration_seconds_bucket[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_turn_duration_seconds_bucket[1m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Agent tool calls by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tool, outcome) (rate(agent_tool_calls_total[5m]))",
     "legendFormat": "{{tool}} {{outcome}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "LLM self-repairs by reason",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(agent_repairs_total[5m]))",
     "legendFormat": "{{reason}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "LLM tokens / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (rate(llm_tokens_total[5m]))",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "LLM spend (USD, cumulative)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(llm_cost_usd_total)",
     "legendFormat": "USD"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "LLM errors / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model) (rate(llm_calls_total{outcome=\"error\"}[5m]))",
     "legendFormat": "{{model}}"
    }
   ]
  }
 ]
}